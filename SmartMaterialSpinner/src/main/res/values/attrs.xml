<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="SmartMaterialSpinner">

        <!-- Dialog or BottomSheet -->
        <attr name="spinnerMode" format="enum">
            <enum name="dialog" value="0"/>
            <enum name="bottomSheet" value="1"/>
        </attr>

        <!-- Enable search -->
        <attr name="enableSearch" format="boolean"/>

        <!-- Optional title -->
        <attr name="spinnerTitle" format="string"/>

    </declare-styleable>

</resources>
